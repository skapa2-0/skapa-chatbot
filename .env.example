# Copy this file to .env and fill in the values
# Never commit .env to git

# PostgreSQL (auto-injected by Railway when you add a PostgreSQL service)
DATABASE_URL=postgresql://user:password@localhost:5432/skapa_chatbot

# Anthropic Claude API key
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key-here

# JWT secret for admin endpoints (generate with: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-random-string

# Admin token for /api/scrape/run (generate with: openssl rand -hex 24)
ADMIN_TOKEN=change-this-to-a-random-token

# Scraper
SCRAPER_TARGET_URL=https://skapa-academy.com
SCRAPER_INTERVAL_HOURS=24
SCRAPER_USER_AGENT=SkapaChatbotBot/1.0

# Ollama LLM model (local, lightweight)
OLLAMA_MODEL=llama3.2:1b

# Ollama cloud API key (for benchmarking only - optional)
OLLAMA_API_KEY=your-ollama-cloud-api-key-here
