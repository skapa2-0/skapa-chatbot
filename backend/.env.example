# Base de données (SQLite par défaut, aucune installation requise)
DATABASE_URL=sqlite:///skapa.db
# Exemple PostgreSQL en production :
# DATABASE_URL=postgresql://user:password@localhost:5432/skapa_chatbot

# Clé API Anthropic (https://console.anthropic.com/) - nécessaire pour générer les réponses
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Jeton pour protéger les endpoints admin (/api/ingest, /api/detect, /api/sync/supabase)
ADMIN_TOKEN=change-me

# --- Source de données ---
# Cible par défaut de l'ingestion. Le type est détecté automatiquement :
# site HTML, SPA rendue en JS, API JSON, WordPress, Shopify, sitemap.xml,
# flux RSS/Atom, CSV, PDF, fichier local, ou supabase://table
SCRAPER_TARGET_URL=https://example.com
SCRAPER_USER_AGENT=SkapaChatbotBot/1.0
SCRAPER_INTERVAL_HOURS=24
SCRAPER_MAX_PAGES=30

# Rendu JavaScript (Playwright) : auto = décidé page par page selon le DOM,
# always = force Chromium partout, never = requests uniquement (plus rapide).
# Nécessite `playwright install chromium`.
SCRAPER_RENDER_JS=auto
SCRAPER_RENDER_TIMEOUT_MS=15000

# Utiliser /sitemap.xml quand il existe plutôt que de suivre les liens à l'aveugle
SCRAPER_PREFER_SITEMAP=true
SITEMAP_MAX_CHILDREN=5

# Délai réseau (secondes) des requêtes d'ingestion
INGEST_TIMEOUT=15

# Bornes de taille d'un document avant découpage en chunks
MIN_DOC_CHARS=40
MAX_DOC_CHARS=50000

# Source Supabase : le chatbot lit directement ces tables via l'API REST.
# Le schéma n'a pas besoin d'être connu : chaque ligne est aplatie
# automatiquement en "colonne: valeur".
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_TABLES=

# --- Multi-sites ---
# Identifiant du site propriétaire des contenus quand le widget n'envoie pas
# de data-site-id. Une même API peut servir plusieurs sites clients : la
# recherche est cloisonnée par site_id.
DEFAULT_SITE_ID=default

# Nombre de chunks renvoyés au modèle pour répondre
CHATBOT_TOP_K=4

# Base vectorielle Chroma (RAG) : dossier de persistance + taille des chunks (en tokens)
CHROMA_DIR=chroma_db
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=40

# Origines autorisées à appeler l'API (widget embarqué sur un site client)
# "*" en dev, liste séparée par des virgules en prod, ex: https://client1.com,https://client2.com
ALLOWED_ORIGINS=*
