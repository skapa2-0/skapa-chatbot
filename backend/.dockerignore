# Le .env n'entre PAS dans l'image (les secrets resteraient dans les
# couches) : docker-compose l'injecte à l'exécution via env_file.
.env

# Environnements et caches locaux
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Données locales : l'index et la base vivent dans le volume /data
chroma_db/
instance/
*.db
